# Server Port (Render sets this automatically via PORT env var)
PORT=5000

# MongoDB Atlas connection string (direct shard, not SRV)
MONGODB_URI=mongodb://username:password@host1:port,host2:port,host3:port/database?ssl=true&authSource=admin

# JWT secret — generate a strong random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-strong-random-secret-here

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-bucket.r2.dev

# WhatsApp notifications via Gupshup (application received + status changes).
# Leave GUPSHUP_API_KEY empty to disable — nothing breaks, messages are just logged as "skipped".
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=91XXXXXXXXXX
GUPSHUP_APP_NAME=
# Approved template ids (UUIDs from the Gupshup dashboard). See src/utils/notifications.js for the wording.
# Both templates have a dynamic URL button: https://careers.harekrishnavizag.org/track?id={{1}}
GUPSHUP_TPL_RECEIVED=
GUPSHUP_TPL_STATUS_UPDATE=
# Statuses that auto-send a message (default: all except "received")
# GUPSHUP_NOTIFY_STATUSES=under-review,shortlisted,interview,selected,rejected
# Simple key for the delivery webhook. In Gupshup set the callback URL to:
#   https://<your-api-host>/api/webhooks/gupshup?key=<this value>
GUPSHUP_WEBHOOK_KEY=
# Public careers site URL used in the "track your application" link
PUBLIC_SITE_URL=https://careers.harekrishnavizag.org
# Safety cap so the public form can't be used to spam one number (default 8 per 24h)
# WHATSAPP_MAX_PER_NUMBER_PER_DAY=8

# Frontend URL (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000,https://your-frontend.vercel.app
