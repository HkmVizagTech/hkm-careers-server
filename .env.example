# Server Port (Render sets this automatically via PORT env var)
PORT=5000

# MongoDB Atlas connection string (direct shard, not SRV)
MONGODB_URI=mongodb://username:password@host1:port,host2:port,host3:port/database?ssl=true&authSource=admin

# JWT secret — generate a strong random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-strong-random-secret-here

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-bucket.r2.dev

# WhatsApp notifications via Gupshup (application received + status changes).
# Leave GUPSHUP_API_KEY empty to disable — nothing breaks, messages are just logged as "skipped".
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=91XXXXXXXXXX
GUPSHUP_APP_NAME=
# Approved template ids (UUIDs from the Gupshup dashboard). See src/utils/notifications.js for the wording.
# Both templates have a dynamic URL button: https://careers.harekrishnavizag.org/track?id={{1}}
GUPSHUP_TPL_RECEIVED=
GUPSHUP_TPL_STATUS_UPDATE=
# Interview date/time message (template: job_interview_scheduled)
GUPSHUP_TPL_INTERVIEW=
# Statuses that auto-send a message (default: all except "received")
# GUPSHUP_NOTIFY_STATUSES=under-review,shortlisted,interview,selected,rejected
# Simple key for the delivery webhook. In Gupshup set the callback URL to:
#   https://<your-api-host>/api/webhooks/gupshup?key=<this value>
GUPSHUP_WEBHOOK_KEY=
# Public careers site URL used in the "track your application" link
PUBLIC_SITE_URL=https://careers.harekrishnavizag.org

# Frontend URL (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000,https://your-frontend.vercel.app

# ---- Admin reminders (bell icon in the admin area) ----
# Applications still "Received" after this many days are flagged (one digest per day)
UNREVIEWED_AFTER_DAYS=3
# Warn this many days before a job's application deadline (jobs auto-close after it)
JOB_CLOSING_WARN_DAYS=3
# How often the reminder checks run
REMINDER_INTERVAL_MINUTES=15
# Set to true to switch the background checks off (e.g. on a second instance)
DISABLE_REMINDERS=false

# ---- Email (candidate updates, HR alerts, messages from admin) ----
# Option A (now): the mailbox's own email + password over SMTP. hkmvizag.org is on Microsoft 365,
#   so the server defaults to smtp.office365.com:587 (STARTTLS). The mailbox needs "Authenticated SMTP" on.
#   Microsoft turns password SMTP off by default at the end of December 2026: move to Option B before then.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# Option B (Microsoft 365, no password): app registration with Mail.Send (application) + admin consent.
#   When these are set they are used instead of SMTP.
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# Option C: Gmail API (GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, GMAIL_REFRESH_TOKEN; see scripts/gmail-auth.js)
# Shown as the sender. Must be the same mailbox as SMTP_USER (or the Graph / Gmail sending account).
MAIL_FROM="HKM Vizag Careers <careers@hkmvizag.org>"
# Where candidate replies go (optional; defaults to MAIL_FROM)
MAIL_REPLY_TO=
# Inboxes that get a "new application" email with the resume attached (comma-separated, optional)
HR_NOTIFY_EMAILS=
# Candidate updates go by email. WhatsApp is off unless set to all, or a list like received,status,interview
WHATSAPP_SEND=none
